# Django
SECRET_KEY=change-me-to-a-real-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.gov.in

# HTTPS: set False for LAN staging over HTTP only; True when users use HTTPS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
# Comma-separated origins for manage login POST over HTTPS, e.g. https://staging.example.gov.in
# CSRF_TRUSTED_ORIGINS=https://staging.example.gov.in

# Restrict /admin/ and /issuer/manage/ — workstation/VPN IPs or office CIDR (comma-separated).
# NOT the server IP: if the server is 10.1.1.97 and you browse from 10.1.1.42, allow 10.1.1.42.
# Required when DEBUG=False. With nginx+gunicorn also set TRUST_X_FORWARDED_FOR=True (see README).
# ADMIN_IP_ALLOWLIST=10.1.1.42,10.1.1.0/24
TRUST_X_FORWARDED_FOR=True
# Only these immediate peers may supply client-IP headers.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Database
DB_NAME=digilocker
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://user:password@localhost:5432/digilocker

# DigiLocker Issuer Config
ISSUER_ID=in.gov.state.department
API_KEY=your-shared-api-key
BASE_STORAGE_PATH=/data/docs
GPF_STORAGE_PATH=/data/gpf
CERT_ISSUER_NAME=Office of the Principal Accountant General(A&E) Nagaland

# Operational Modes (STRICT | LOG_AND_SERVE)
INTEGRITY_MODE=STRICT
# Identity Validation (STRICT | LENIENT)
IDENTITY_VALIDATION_MODE=STRICT
# Min name similarity for LENIENT mode (0.0–1.0, e.g. 0.70 = 70%)
LENIENT_NAME_MATCH_THRESHOLD=0.70

# Limits
MAX_FILE_SIZE_MB=10
REQUEST_TIMEOUT_MS=5000
TIMESTAMP_SKEW_SECONDS=300

# HMAC header encoding. Keep STANDARD unless DigiLocker explicitly sends its
# test-interface format: Base64 of the lowercase hexadecimal HMAC digest.
# Allowed values: STANDARD | DIGILOCKER_HEX
HMAC_ENCODING_MODE=STANDARD

# Log safe HMAC mismatch shape diagnostics (off by default; console only).
# Never logs request XML, API keys, signatures, KeyHash values, or body digests.
ISSUER_VERBOSE_LOGGING=False

# Dedicated rotated log file for DigiLocker API (pull_doc.*). Leave empty to disable file logging.
# Production example: /var/log/digilocker/issuer-api.log
# Create the directory and grant write access to the gunicorn user before enabling.
# ISSUER_API_LOG_PATH=/var/log/digilocker/issuer-api.log
# ISSUER_API_LOG_MAX_BYTES=10485760
# ISSUER_API_LOG_BACKUP_COUNT=10

# Management console: database-backed lockout after repeated failures (per client IP)
MANAGE_LOGIN_MAX_FAILURES=5
MANAGE_LOGIN_LOCKOUT_MINUTES=15
