# Django
SECRET_KEY=change-me-to-a-real-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.gov.in

# Restrict /admin/ and /issuer/manage/ to these IPs or CIDRs (required in production when DEBUG=False)
# ADMIN_IP_ALLOWLIST=127.0.0.1,10.0.0.0/8,192.168.1.0/24
# Set True only when behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_X_FORWARDED_FOR=False

# Database
DB_NAME=digilocker
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://user:password@localhost:5432/digilocker

# DigiLocker Issuer Config
ISSUER_ID=in.gov.state.department
API_KEY=your-shared-api-key
BASE_STORAGE_PATH=/data/docs

# Operational Modes (STRICT | LOG_AND_SERVE)
INTEGRITY_MODE=STRICT
# Identity Validation (STRICT | LENIENT)
IDENTITY_VALIDATION_MODE=STRICT
# Min name similarity for LENIENT mode (0.0–1.0, e.g. 0.70 = 70%)
LENIENT_NAME_MATCH_THRESHOLD=0.70

# Limits
MAX_FILE_SIZE_MB=10
REQUEST_TIMEOUT_MS=5000
TIMESTAMP_SKEW_SECONDS=300
